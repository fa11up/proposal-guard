pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";
import {TimelockController} from "@openzeppelin/contracts/governance/TimelockController.sol";
import {ProposalGuard, IGovernorLike} from "../src/ProposalGuard.sol";
import {VotesToken, TimelockGovernor} from "./testbed/Testbed.sol";

/// @notice The guard's on-chain splice reproduces, byte for byte, the hash of the document that
/// script/question-template.mjs builds from question/template.json with the control plane's
/// canonicalisation. Generated with:
///   node script/question-template.mjs question/template.json \
///     --governor 0x00000000000000000000000000000000000000aa --chain 31337 \
///     --sample 115792089237316195423570985008687907853269984665640564039457584007913129639935
/// Regenerate these constants whenever the template changes.
contract TemplateVectorTest is Test {
    bytes constant VEC_HEAD =
        hex"";
    bytes constant VEC_TAIL =
        hex"";
    bytes32 constant VEC_HASH = 0x955a3916e120524124eba84f013aa7c3deb7853140bfc881f0e7a16eb3132ef2;

    function test_GuardSpliceMatchesGeneratorVector() public {
        VotesToken token = new VotesToken(address(this));
        TimelockController tl = new TimelockController(1 days, new address[](0), new address[](0), address(this));
        TimelockGovernor gov = new TimelockGovernor(token, tl);
        ProposalGuard guard = new ProposalGuard(IGovernorLike(address(gov)), 180 days, VEC_HEAD, VEC_TAIL);
        assertEq(guard.expectedQuestionHash(type(uint256).max, 100, 200), VEC_HASH);
    }
}
